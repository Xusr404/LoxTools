<Window x:Class="LoxTools.VersionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:LoxTools.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding TitleText}"
        Width="520"
        Height="560"
        MinWidth="420"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#0E1113"
        FontFamily="Segoe UI">

    <!-- Theme merge MUST be available before any StaticResource usage in the start tag.
         Therefore: no StaticResource in the start tag; Foreground is set via Window style below. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/AppTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Now resources exist -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
            </Style>

            <DataTemplate x:Key="InstalledVersionItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"
                               VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Border Width="{Binding ElementName=Root, Path=ActualWidth}"
                MaxWidth="1080"
                HorizontalAlignment="Center"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding TitleText}"
                           FontSize="{StaticResource FsTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushPrimary}"
                           Margin="2,0,0,14"/>

                <ScrollViewer x:Name="ContentScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Header -->
                                    <RowDefinition Height="*"/>
                                    <!-- ListBox -->
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding InstalledVersionsHeader}"
                                           FontSize="{StaticResource FsSection}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>
                                <ListBox x:Name="InstalledVersionsList"
                                         Grid.Row="1"
                                         ItemsSource="{Binding InstalledVersions}"
                                         SelectedItem="{Binding SelectedInstalledVersion}"
                                         ItemTemplate="{StaticResource InstalledVersionItemTemplate}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseWheel="ListBox_PreviewMouseWheel"
                                         Margin="0,0,0,8"
                                         MouseDoubleClick="InstalledVersions_MouseDoubleClick"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding LaunchModeTitle}"
                                           FontSize="{StaticResource FsSection}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding LaunchModeManagedHint}"
                                               FontSize="{StaticResource FsSecondary}"
                                               Foreground="{StaticResource BrushSecondary}"
                                               Margin="0,0,16,0"
                                               TextWrapping="Wrap"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource FooterButtonStyle}"
                                            Click="OpenSettings_Click"
                                            HorizontalAlignment="Right">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OpenSettingsLabel}"
                                                           Margin="0,0,8,0"/>
                                                <Path Data="{StaticResource OpenSettingsGeometry}"
                                                      Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      Fill="{StaticResource IconBrush}"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Separator Margin="0,12" Opacity="0.22"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding AlwaysShowVersionDialogLabel}"
                                                   FontSize="{StaticResource FsLabel}"/>
                                        <TextBlock Text="{Binding AlwaysShowVersionDialogHint}"
                                                   FontSize="{StaticResource FsSecondary}"
                                                   Foreground="{StaticResource BrushSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource SwitchStyle}"
                                                  IsChecked="{Binding AlwaysShowSelectionDialog, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Style="{StaticResource FooterDeleteButtonStyle}"
                            Content="{Binding CancelText}"
                            Click="Cancel_Click"
                            Margin="0,0,12,0"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource FooterButtonStyle}"
                            Content="{Binding OkText}"
                            Click="Ok_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
