<Window x:Class="LoxTools.VersionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:LoxTools.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding TitleText}"
        Width="520"
        Height="560"
        MinWidth="420"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource BrushPrimary}">

    <!-- Dynamic window resources resolve after the shared dictionaries load. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/UtilityWindows.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="InstalledVersionItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"
                               VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Border Width="{Binding ElementName=Root, Path=ActualWidth}"
                MaxWidth="1080"
                HorizontalAlignment="Center"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding TitleText}"
                           FontSize="{DynamicResource FsTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushPrimary}"
                           Margin="2,0,0,14"/>

                <ScrollViewer x:Name="ContentScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding InstalledVersionsHeader}"
                                           FontSize="{DynamicResource FsSection}"
                                           FontWeight="SemiBold"
                                           Margin="{DynamicResource SectionHeadingMargin}"/>
                                <ListBox x:Name="InstalledVersionsList"
                                         ItemsSource="{Binding InstalledVersions}"
                                         SelectedItem="{Binding SelectedInstalledVersion}"
                                         ItemTemplate="{StaticResource InstalledVersionItemTemplate}"
                                         PreviewMouseWheel="ListBox_PreviewMouseWheel"
                                         MouseDoubleClick="InstalledVersions_MouseDoubleClick"/>
                                <Separator Margin="{DynamicResource SettingsInlineRowSeparatorMargin}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LaunchModeManagedHint}"
                                               FontSize="{DynamicResource FsSecondary}"
                                               Foreground="{DynamicResource BrushSecondary}"
                                               Margin="{DynamicResource InlineContentMargin}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="{Binding OpenSettingsLabel}"
                                            Style="{DynamicResource QuietLinkButtonStyle}"
                                            Click="OpenSettings_Click"/>
                                </Grid>
                                <Grid Margin="{DynamicResource SelectorPreferenceMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AlwaysShowVersionDialogLabel}"
                                               ToolTip="{Binding AlwaysShowVersionDialogHint}"
                                               FontSize="{DynamicResource FsLabel}"
                                               Margin="{DynamicResource InlineContentMargin}"
                                               VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{DynamicResource SwitchStyle}"
                                                  AutomationProperties.Name="{Binding AlwaysShowVersionDialogLabel}"
                                                  IsChecked="{Binding AlwaysShowSelectionDialog, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Style="{DynamicResource FooterButtonStyle}"
                            FocusVisualStyle="{DynamicResource UtilityFocusStyle}"
                            Content="{Binding CancelText}"
                            Click="Cancel_Click"
                            IsCancel="True"
                            Margin="0,0,12,0"/>

                    <Button Grid.Column="2"
                            Style="{DynamicResource PrimaryActionButtonStyle}"
                            Content="{Binding OkText}"
                            IsDefault="True"
                            Click="Ok_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
