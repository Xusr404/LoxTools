<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
	<UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\LoxTools.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>LoxTools</Product>
    <AssemblyName>LoxTools</AssemblyName>
    <RootNamespace>LoxTools</RootNamespace>
    <Company>Xusr404</Company>
    <Authors>Xusr404</Authors>
    <LoxToolsUpdatePublisher Condition="'$(LoxToolsUpdatePublisher)' == ''"></LoxToolsUpdatePublisher>
    <RunPostBuildEvent></RunPostBuildEvent>
    <Configurations>Debug;Release;ReleaseVersion;HotFeatures;DeleteRegistryEntries</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LoxToolsUpdatePublisher</_Parameter1>
      <_Parameter2>$(LoxToolsUpdatePublisher)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="IWshRuntimeLibrary">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>f935dc20-1cf0-11d0-adb9-00c04fd58a0b</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SingleInstanceCore" Version="2.2.2" />
    <PackageReference Include="WindowsShortcutFactory" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Language\Lang.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Lang.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="Ui\Tray\ContextMenuItems\ToolStripItems\ActionToolStripItem.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="temp\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\LoxTools.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Language\Lang.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Lang.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
