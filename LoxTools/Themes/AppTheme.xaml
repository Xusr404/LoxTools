<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:LoxTools.UI.Converters;assembly=LoxTools">

    <!-- Typography -->
    <sys:Double x:Key="FsTitle">22</sys:Double>
    <sys:Double x:Key="FsSection">17.5</sys:Double>
    <sys:Double x:Key="FsLabel">13.5</sys:Double>
    <sys:Double x:Key="FsSecondary">12.5</sys:Double>

    <!-- Colors -->
    <SolidColorBrush x:Key="BrushPrimary" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="BrushSecondary" Color="#B8BDC4"/>
    <SolidColorBrush x:Key="BrushCard" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BrushCardBorder" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="BrushHover" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="BrushPressed" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#67D37A"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#E3C84D"/>
    <SolidColorBrush x:Key="IconBrush" Color="#67D37A"/>
    <SolidColorBrush x:Key="BrushCardStrong" Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="BrushComboBoxBg" Color="#181E1C"/>
    <SolidColorBrush x:Key="BrushComboBoxHoverBg" Color="#202723"/>
    <SolidColorBrush x:Key="BrushComboBoxOpenBg" Color="#262F2A"/>
    <SolidColorBrush x:Key="BrushPopupBg" Color="#CC1A1F1C"/>
    <SolidColorBrush x:Key="BrushPopupItemBg" Color="#901A1F1C"/>
    <SolidColorBrush x:Key="BrushPopupItemHoverBg" Color="#B02A302C"/>
    <SolidColorBrush x:Key="BrushPopupItemSelectedBg" Color="#6637C65A"/>

    <!-- Delete (danger) colors - frosted & subtle -->
    <SolidColorBrush x:Key="BrushDangerBorder" Color="#88E06A6A"/>
    <SolidColorBrush x:Key="BrushDangerText" Color="#E06A6A"/>
    <SolidColorBrush x:Key="BrushDangerBg" Color="#22E06A6A"/>
    <SolidColorBrush x:Key="BrushDangerHover" Color="#33E06A6A"/>
    <SolidColorBrush x:Key="BrushDangerPressed" Color="#44E06A6A"/>
    <SolidColorBrush x:Key="BrushWarningBorder" Color="#88E3C84D"/>
    <SolidColorBrush x:Key="BrushWarningBg" Color="#22E3C84D"/>
    <SolidColorBrush x:Key="BrushWarningHover" Color="#33E3C84D"/>
    <SolidColorBrush x:Key="BrushWarningPressed" Color="#44E3C84D"/>
    <SolidColorBrush x:Key="BrushAccentBorder" Color="#8867D37A"/>
    <SolidColorBrush x:Key="BrushAccentBg" Color="#2267D37A"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#3367D37A"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#4467D37A"/>

    <!-- Footer glass buttons -->
    <SolidColorBrush x:Key="BrushFooterBg" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BrushFooterBorder" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="BrushFooterHover" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="BrushFooterPressed" Color="#2EFFFFFF"/>

    <!-- ListBox sizing (min 1 item, max 10 items) -->
    <sys:Double x:Key="ListBoxItemHeight">40</sys:Double>
    <Thickness x:Key="ListBoxItemMargin">0,0,0,6</Thickness>
    <sys:Double x:Key="ListBoxMinHeight">40</sys:Double>
    <sys:Double x:Key="ListBoxMaxHeight">400</sys:Double>
    <sys:Double x:Key="PathDeleteButtonSize">28</sys:Double>
    <sys:Double x:Key="PathDeleteIconSize">16</sys:Double>
    <sys:Double x:Key="PathDeleteIdleOpacity">0.72</sys:Double>
    <sys:Double x:Key="PathDeletePressedOpacity">0.52</sys:Double>
    <Geometry x:Key="TrashGeometry">M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z</Geometry>


    <!-- Default text color (prevents black text) -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
    </Style>

    <!-- Card -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{StaticResource BrushCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Default Button -->
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource FsLabel}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Background" Value="#18FFFFFF"/>
        <Setter Property="BorderBrush" Value="#28FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#38FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#44FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WarningButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
        <Setter Property="Background" Value="{StaticResource BrushWarningBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushWarningBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushWarningHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushWarningBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushWarningPressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushWarningBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer Buttons -->
    <Style x:Key="FooterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="Background" Value="{StaticResource BrushFooterBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushFooterBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushFooterHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#44FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushFooterPressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton as Switch -->
    <Style x:Key="SwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="54"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track"
                                CornerRadius="14"
                                Background="#24FFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"/>
                        <Ellipse x:Name="Thumb"
                                 Width="22"
                                 Height="22"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 Fill="#E6E6E6"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2BFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2237C65A"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#4067D37A"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource BrushAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBox -->
    <!-- ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource FsSecondary}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="MinHeight" Value="{StaticResource ListBoxMinHeight}"/>
        <Setter Property="MaxHeight" Value="{StaticResource ListBoxMaxHeight}"/>

        <!-- WICHTIG: ListBox darf bei IsEnabled=false NICHT selbst gedimmt werden -->
        <Setter Property="Opacity" Value="1"/>

        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Bd"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                  Focusable="False"
                                  Background="Transparent"
                                  Padding="{TemplateBinding Padding}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- WICHTIG: auch im Template sicherstellen, dass nichts gedimmt wird -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <!-- optional: Text leicht sekundär, aber KEIN Opacity -->
                <Setter Property="Foreground" Value="{StaticResource BrushSecondary}"/>
                <!-- explizit transparent, um White-Fallback zu verhindern -->
                <Setter Property="Background" Value="#00FFFFFF"/>
                <!-- wichtig: ListBox selbst bleibt voll sichtbar -->
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="AppComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource BrushPopupItemBg}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource BrushPopupItemHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource BrushPopupItemSelectedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushSecondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource FsSecondary}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="Background" Value="{StaticResource BrushComboBoxBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter Margin="0,0,18,0"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <Path x:Name="DropGlyph"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0"
                                      Fill="{StaticResource BrushSecondary}"
                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="DropDownToggle"
                                      OverridesDefaultStyle="True"
                                      FocusVisualStyle="{x:Null}"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource BrushPopupBg}"
                                    BorderBrush="{StaticResource BrushCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="4"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushComboBoxHoverBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#38FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#60FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushComboBoxOpenBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#44FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton -->
    <Style x:Key="DarkRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FsLabel}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Row"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="IndicatorOutline"
                                         Stroke="#70FFFFFF"
                                         StrokeThickness="1.4"
                                         Fill="Transparent"/>
                                <Ellipse x:Name="IndicatorFill"
                                         Width="8"
                                         Height="8"
                                         Fill="{StaticResource BrushAccent}"
                                         Visibility="Collapsed"/>
                            </Grid>

                            <ContentPresenter Grid.Column="1"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource BrushPressed}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#1837C65A"/>
                            <Setter TargetName="IndicatorOutline" Property="Stroke" Value="{StaticResource BrushAccent}"/>
                            <Setter TargetName="IndicatorFill" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="#4067D37A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <DataTemplate x:Key="PathItemTemplate">
        <TextBlock Text="{Binding}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding}"/>
    </DataTemplate>

    <!-- ListBoxItem -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="{StaticResource ListBoxItemMargin}"/>
        <Setter Property="Height" Value="{StaticResource ListBoxItemHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                        Background="#1CFFFFFF"
                        BorderBrush="#3AFFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Accent"
                                Width="3"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                Margin="6,6,0,6"
                                CornerRadius="2"/>
                            <ContentPresenter Margin="14,4,4,4"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#48FFFFFF"/>
                        </Trigger>

                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A37C65A"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5067D37A"/>
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource BrushAccent}"/>
                        </Trigger>

                        <!-- ListBox "locked" (IsHitTestVisible=false) + NOT selected => dim -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHitTestVisible, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       Value="False"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}"
                       Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </MultiDataTrigger>

                        <!-- ListBox "locked" + selected => normal -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHitTestVisible, RelativeSource={RelativeSource AncestorType=ListBox}}"
                       Value="False"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}"
                       Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern ScrollBar -->
    <Style x:Key="ModernThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd"
                            Background="#40FFFFFF"
                            CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="#70FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="#90FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbBd" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0"
                                              IsHitTestVisible="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernThumbStyle}"
                                       MinHeight="30"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0"
                                              IsHitTestVisible="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Delete Button -->
    <Style x:Key="DeleteButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="BorderBrush" Value="#28FFFFFF"/>
        <Setter Property="Background" Value="#18FFFFFF"/>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushDangerText}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushDangerBorder}"/>
                <Setter Property="Background" Value="{StaticResource BrushDangerBg}"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushDangerHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushDangerPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PathDeleteButtonStyle"
           TargetType="Button">
        <Setter Property="Width" Value="{StaticResource PathDeleteButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource PathDeleteButtonSize}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushDangerText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="{StaticResource PathDeleteIdleOpacity}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="{StaticResource PathDeletePressedOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer Delete Button -->
    <Style x:Key="FooterDeleteButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FooterButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushDangerText}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushDangerBorder}"/>
                <Setter Property="Background" Value="{StaticResource BrushDangerBg}"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushDangerHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushDangerPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Footer Accent Button -->
    <Style x:Key="FooterAccentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FooterButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}"/>
                <Setter Property="Background" Value="{StaticResource BrushAccentBg}"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAccentPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>


    <!-- Apply modern scrollbar everywhere -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarStyle}"/>
</ResourceDictionary>
