    <Style x:Key="OnboardingStepTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsOnboardingStepTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
    </Style>

    <Style x:Key="OnboardingStepDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsOnboardingStepBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="OnboardingHintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsSecondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
