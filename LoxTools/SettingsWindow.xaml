<Window x:Class="LoxTools.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ui="clr-namespace:LoxTools.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding LangSettings}"
        Width="980"
        Height="{DynamicResource SettingsWindowHeight}"
        MinWidth="{DynamicResource SettingsWindowMinWidth}"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource BrushPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/UtilityWindows.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="PathItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{DynamicResource UtilityFolderGeometry}"
                          Width="{DynamicResource UtilityFolderIconSize}"
                          Height="{DynamicResource UtilityFolderIconSize}"
                          Margin="{DynamicResource UtilityFolderIconMargin}"
                          Stretch="Uniform" Stroke="{DynamicResource BrushSecondary}"
                          StrokeThickness="{DynamicResource UtilityIconStrokeThickness}"
                          VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip="{Binding}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource PathDeleteButtonStyle}"
                            Click="RemovePath_Click"
                            ToolTip="{Binding DataContext.LangDelete, RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.Name="{Binding DataContext.LangDelete, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Viewbox Width="{StaticResource PathDeleteIconSize}"
                                 Height="{StaticResource PathDeleteIconSize}">
                            <Path Data="{StaticResource TrashGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>



    <!-- Root named for binding -->
    <Grid x:Name="Root">

        <!-- Page container:
             - Width follows available space (so it doesn't become "too narrow" on small windows)
             - MaxWidth clamps at 1080
             - stays centered -->
        <Border Width="{Binding ElementName=Root, Path=ActualWidth}"
                MaxWidth="1080"
                HorizontalAlignment="Center"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title (standalone) -->
                <TextBlock Grid.Row="0"
                           Text="{Binding LangSettings}"
                           FontSize="{DynamicResource FsTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushPrimary}"
                           Margin="2,0,0,14"/>

                <!-- Scroll content -->
                <ScrollViewer x:Name="Scroll"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Grid.Row="1">

                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <!-- IMPORTANT:
                         - no MaxWidth here (handled by outer container)
                         - Stretch so content uses full available width -->
                    <Border HorizontalAlignment="Stretch">
                        <StackPanel Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch">

                            <!-- SECTION: Allgemein -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding StartupTrayTitle}"
                                                   FontSize="{DynamicResource FsSection}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding LangWindowsAutostartup}"
                                                       FontSize="{DynamicResource FsLabel}"/>
                                            <TextBlock Text="{Binding LangRunAtWindowsStartup}"
                                                       FontSize="{DynamicResource FsSecondary}"
                                                       Foreground="{DynamicResource BrushSecondary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchStyle}"
                                                      IsChecked="{Binding Autostartup}"/>
                                    </Grid>

                                    <Separator Margin="0,14" Opacity="0.22"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding LangAlwaysShowVersionDialog}"
                                                       FontSize="{DynamicResource FsLabel}"/>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchStyle}"
                                                      IsChecked="{Binding AlwaysShowSelectionDialog}"/>
                                    </Grid>

                                    <Separator Margin="{StaticResource SettingsInlineRowSeparatorMargin}" Opacity="0.22"/>

                                    <Button Content="{Binding TrayOnboardingSettingsButton}"
                                            Style="{DynamicResource QuietLinkButtonStyle}"
                                            ToolTip="{Binding TrayOnboardingSettingsHint}"
                                            Click="ShowTrayOnboarding_Click"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Launch behavior stays together in its own section. -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding LaunchModeTitle}"
                                                   FontSize="{DynamicResource FsSection}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,2"/>
                                        <RadioButton Style="{StaticResource DarkRadioButtonStyle}"
                                                     GroupName="VersionModeSettings"
                                                     IsChecked="{Binding UseLatestVersion, Mode=TwoWay}"
                                                     Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding UseLatestVersionOptionTitle}"
                                                           FontSize="{DynamicResource FsLabel}"/>
                                                <TextBlock Text="{Binding UseLatestVersionOptionHint}"
                                                           FontSize="{DynamicResource FsSecondary}"
                                                           Foreground="{DynamicResource BrushSecondary}"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock FontSize="{DynamicResource FsSecondary}"
                                                           Foreground="{DynamicResource BrushSecondary}"
                                                           Margin="0,3,0,0">
                                                    <Run Text="{Binding LatestVersionLabel, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding LatestVersionValue, Mode=OneWay}"
                                                         Foreground="{DynamicResource BrushAccent}"
                                                         FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton Style="{StaticResource DarkRadioButtonStyle}"
                                                     GroupName="VersionModeSettings"
                                                     IsChecked="{Binding UseFixedVersion, Mode=TwoWay}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding UseFixedVersionOptionTitle}"
                                                               FontSize="{DynamicResource FsLabel}"/>
                                                    <TextBlock Text="{Binding UseFixedVersionOptionHint}"
                                                               FontSize="{DynamicResource FsSecondary}"
                                                               Foreground="{DynamicResource BrushSecondary}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding InstalledVersions}"
                                                          SelectedItem="{Binding SelectedFixedVersion, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          MinWidth="240"
                                                          MaxWidth="360"
                                                          HorizontalAlignment="Right"
                                                          IsEnabled="{Binding UseFixedVersion}"
                                                          Style="{StaticResource AppComboBoxStyle}"/>
                                            </Grid>
                                        </RadioButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: Pfade -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding InstallationsProjectsTitle}"
                                                   FontSize="{DynamicResource FsSection}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- Installation paths -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding LangInstallationpaths}"
                                                       FontSize="{DynamicResource FsLabel}"/>
                                            <TextBlock Text="{Binding LangConfigDirectoryPaths}"
                                                       FontSize="{DynamicResource FsSecondary}"
                                                       Foreground="{DynamicResource BrushSecondary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="10,0,0,0">
                                            <Button Content="{Binding AddFolderLabel}" Click="BrowseConfig_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,10,0,0"
                                            CornerRadius="10"
                                            Background="{DynamicResource BrushWarningBg}"
                                            BorderBrush="{DynamicResource BrushWarningBorder}"
                                            BorderThickness="1"
                                            Padding="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConfigPaths.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" Margin="0,2,10,0">
                                                <Path Fill="{DynamicResource BrushWarning}"
                                                      Data="M12 2L1 22h22L12 2zm0 6c.6 0 1 .4 1 1v5c0 .6-.4 1-1 1s-1-.4-1-1V9c0-.6.4-1 1-1zm0 10a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3z"/>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding LangNoInstallationPathTitle}"
                                                           FontSize="{DynamicResource FsLabel}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LangNoInstallationPathDescription}"
                                                           FontSize="{DynamicResource FsSecondary}"
                                                           Foreground="{DynamicResource BrushSecondary}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock FontSize="{DynamicResource FsSecondary}"
                                                           Foreground="{DynamicResource BrushSecondary}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="{Binding DefaultConfigPathLabel, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding DefaultConfigPathValue, Mode=OneWay}"
                                                         Foreground="{DynamicResource BrushAccent}"
                                                         FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Vertical"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                <Button Content="{Binding LangNoInstallationPathUseSuggestedButton}"
                                                        Click="UseSuggestedConfigPath_Click"
                                                        IsEnabled="{Binding CanUseSuggestedConfigPath}"
                                                        HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ListBox ItemsSource="{Binding ConfigPaths}"
                                             SelectedItem="{Binding SelectedConfigPath}"
                                             KeyDown="ConfigPaths_KeyDown"
                                             PreviewMouseWheel="ListBox_PreviewMouseWheel"
                                             ItemTemplate="{StaticResource PathItemTemplate}">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConfigPaths.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                    </ListBox>

                                    <TextBlock Text="{Binding ConfigMessage}"
                                               FontSize="{DynamicResource FsSecondary}"
                                               Foreground="{DynamicResource BrushSecondary}"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding ConfigMessageVisibility}"/>

                                    <Separator Margin="0,14" Opacity="0.22"/>

                                    <!-- Project paths -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding LangProjectDirectorypaths}"
                                                       FontSize="{DynamicResource FsLabel}"/>
                                            <TextBlock Text="{Binding LangProjectFoldersHint}"
                                                       FontSize="{DynamicResource FsSecondary}"
                                                       Foreground="{DynamicResource BrushSecondary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="10,0,0,0">
                                            <Button Content="{Binding AddFolderLabel}" Click="BrowseProjects_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,10,0,0"
                                            CornerRadius="10"
                                            Background="{DynamicResource BrushWarningBg}"
                                            BorderBrush="{DynamicResource BrushWarningBorder}"
                                            BorderThickness="1"
                                            Padding="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProjectPaths.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" Margin="0,2,10,0">
                                                <Path Fill="{DynamicResource BrushWarning}"
                                                      Data="M12 2L1 22h22L12 2zm0 6c.6 0 1 .4 1 1v5c0 .6-.4 1-1 1s-1-.4-1-1V9c0-.6.4-1 1-1zm0 10a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3z"/>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding LangNoProjectPathTitle}"
                                                           FontSize="{DynamicResource FsLabel}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LangNoProjectPathDescription}"
                                                           FontSize="{DynamicResource FsSecondary}"
                                                           Foreground="{DynamicResource BrushSecondary}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock FontSize="{DynamicResource FsSecondary}"
                                                           Foreground="{DynamicResource BrushSecondary}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="{Binding DefaultProjectPathLabel, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding DefaultProjectPathValue, Mode=OneWay}"
                                                         Foreground="{DynamicResource BrushAccent}"
                                                         FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Vertical"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                <Button Content="{Binding LangNoProjectPathUseSuggestedButton}"
                                                        Click="UseSuggestedProjectPath_Click"
                                                        IsEnabled="{Binding CanUseSuggestedProjectPath}"
                                                        HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ListBox ItemsSource="{Binding ProjectPaths}"
                                             SelectedItem="{Binding SelectedProjectPath}"
                                             KeyDown="ProjectPaths_KeyDown"
                                             PreviewMouseWheel="ListBox_PreviewMouseWheel"
                                             ItemTemplate="{StaticResource PathItemTemplate}">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProjectPaths.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                    </ListBox>

                                    <TextBlock Text="{Binding ProjectsMessage}"
                                               FontSize="{DynamicResource FsSecondary}"
                                               Foreground="{DynamicResource BrushSecondary}"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding ProjectsMessageVisibility}"/>
                                    <Separator Margin="{DynamicResource SettingsInlineRowSeparatorMargin}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding InstallationFoldersTitle}" FontSize="{DynamicResource FsLabel}"/>
                                        <TextBlock Text="{Binding InstallationFoldersHint}" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FsSecondary}" Foreground="{DynamicResource BrushSecondary}"
                                                   Margin="{DynamicResource SettingsInlineActionHintMargin}"/>
                                        <RadioButton Content="{Binding InstallationFoldersVersioned}"
                                                     GroupName="InstallationFolderMode" Style="{DynamicResource DarkRadioButtonStyle}"
                                                     IsChecked="{Binding VersionedInstallationFolders, Mode=TwoWay}"/>
                                        <RadioButton Content="{Binding InstallationFoldersSingle}"
                                                     GroupName="InstallationFolderMode" Style="{DynamicResource DarkRadioButtonStyle}"
                                                     IsChecked="{Binding SingleInstallationPerChannel, Mode=TwoWay}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <Expander Header="{Binding MoreSettingsTitle}"
                                      Style="{DynamicResource SettingsExpanderStyle}">
                                <StackPanel>
                                    <!-- SECTION: Dateizuordnung -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding FileAssociationDescription}"
                                                               FontSize="{DynamicResource FsSecondary}"
                                                               Foreground="{DynamicResource BrushSecondary}"
                                                               Margin="0,2,0,0"
                                                               Grid.Column="0"
                                                               Grid.Row="0"/>
                                                    <TextBlock FontSize="{DynamicResource FsSecondary}"
                                                               Foreground="{DynamicResource BrushSecondary}"
                                                               Margin="0,6,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FileAssociationStatus}"
                                                               Grid.Column="0"
                                                               Grid.Row="1">
                                                        <Run Text="{Binding FileAssociationStatusLabel, Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding FileAssociationStatusValue, Mode=OneWay}"
                                                             FontWeight="SemiBold">
                                                            <Run.Style>
                                                                <Style TargetType="Run">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushSecondary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFileAssociationMixed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsFileAssociationCurrent}" Value="True"/>
                                                                                <Condition Binding="{Binding IsFileAssociationMixed}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run>
                                                    </TextBlock>
                                                    <Button Grid.Column="1"
                                                            Grid.RowSpan="2"
                                                            Content="{Binding FileAssociationOpenWindowsButton}"
                                                            Click="OpenDefaultApps_Click"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource WarningButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFileAssociationCurrent}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Grid.RowSpan="2"
                                                            Content="{Binding FileAssociationOpenWindowsButton}"
                                                            Click="OpenDefaultApps_Click"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFileAssociationCurrent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{Binding FileAssociationTitle}"
                                                           FontSize="{DynamicResource FsSection}"
                                                           FontWeight="SemiBold"
                                                           Grid.Row="0"/>
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                    <!-- SECTION: LoxTools updates -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppUpdatesSectionTitle}"
                                                       FontSize="{DynamicResource FsSection}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,14"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding AppUpdatesAutomaticTitle}" FontSize="{DynamicResource FsLabel}"/>
                                                    <TextBlock Text="{Binding AppUpdatesAutomaticHint}"
                                                               FontSize="{DynamicResource FsSecondary}"
                                                               Foreground="{DynamicResource BrushSecondary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1"
                                                              Style="{StaticResource SwitchStyle}"
                                                              IsChecked="{Binding AppUpdateAutoCheckEnabled}"/>
                                            </Grid>

                                            <Separator Margin="0,14" Opacity="0.22"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding AppUpdatesChannelTitle}"
                                                               FontSize="{DynamicResource FsLabel}"/>
                                                    <TextBlock Text="{Binding AppUpdatesChannelHint}"
                                                               FontSize="{DynamicResource FsSecondary}"
                                                               Foreground="{DynamicResource BrushSecondary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AppUpdateChannels}"
                                                          SelectedValue="{Binding SelectedAppUpdateChannel, Mode=TwoWay}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="DisplayName"
                                                          MinWidth="180"
                                                          HorizontalAlignment="Right"
                                                          Style="{StaticResource AppComboBoxStyle}"/>
                                            </Grid>

                                            <Separator Margin="0,14" Opacity="0.22"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding AppUpdateStatus}" FontSize="{DynamicResource FsLabel}"/>
                                                    <TextBlock Text="{Binding AppUpdateLastCheck}"
                                                               FontSize="{DynamicResource FsSecondary}"
                                                               Foreground="{DynamicResource BrushSecondary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="{Binding AppUpdatesCheckNow}"
                                                            Click="AppUpdateCheck_Click"
                                                            Margin="0,0,10,0"/>
                                                    <Button Content="{Binding AppUpdateActionLabel}"
                                                            Click="AppUpdateAction_Click"
                                                            Visibility="{Binding AppUpdateActionVisibility}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- SECTION: Erweitert -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="{Binding LangSectionAdvanced}"
                                                           FontSize="{DynamicResource FsSection}"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding LangMiddleMousePressing}"
                                                               FontSize="{DynamicResource FsLabel}"/>
                                                    <TextBlock Text="{Binding LangCloseAllOpenConfig}"
                                                               FontSize="{DynamicResource FsSecondary}"
                                                               Foreground="{DynamicResource BrushSecondary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <ToggleButton Grid.Column="1"
                                                              Style="{StaticResource SwitchStyle}"
                                                              IsChecked="{Binding MiddleMouseButtonEvent}"/>
                                            </Grid>

                                            <Separator Margin="0,14" Opacity="0.22"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding LangUpdateChannelTitle}"
                                                               FontSize="{DynamicResource FsLabel}"/>
                                                    <TextBlock Text="{Binding LangUpdateChannelHint}"
                                                               FontSize="{DynamicResource FsSecondary}"
                                                               Foreground="{DynamicResource BrushSecondary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding UpdateChannels}"
                                                          SelectedValue="{Binding SelectedUpdateChannel, Mode=TwoWay}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="DisplayName"
                                                          MinWidth="180"
                                                          HorizontalAlignment="Right"
                                                          Style="{StaticResource AppComboBoxStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Footer: buttons directly on background -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom">
                        <Button Style="{StaticResource FooterUpdateLinkStyle}"
                                Content="{Binding ApplicationName}"
                                Click="OpenLoxToolsGitHub_Click"/>
                        <TextBlock Text="·"
                                   FontSize="{DynamicResource FsSecondary}"
                                   Foreground="{DynamicResource BrushSecondary}"
                                   Margin="{StaticResource FooterSeparatorMargin}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ApplicationVersionDisplay}"
                                   FontSize="{DynamicResource FsSecondary}"
                                   Foreground="{DynamicResource BrushSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="·"
                                   FontSize="{DynamicResource FsSecondary}"
                                   Foreground="{DynamicResource BrushSecondary}"
                                   Margin="{StaticResource FooterSeparatorMargin}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding AppUpdateFooterVisibility}"/>
                        <Button Style="{StaticResource FooterUpdateLinkStyle}"
                                Content="{Binding AppUpdateFooterText}"
                                Click="AppUpdateAction_Click"
                                IsEnabled="{Binding AppUpdateFooterActionEnabled}"
                                Visibility="{Binding AppUpdateFooterVisibility}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button Style="{DynamicResource FooterButtonStyle}"
                                FocusVisualStyle="{DynamicResource UtilityFocusStyle}"
                                Content="{Binding LangCancel}"
                                Click="Cancel_Click"
                                Margin="0,0,12,0"/>
                        <Button Style="{DynamicResource PrimaryActionButtonStyle}"
                                Content="{Binding LangSave}"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
